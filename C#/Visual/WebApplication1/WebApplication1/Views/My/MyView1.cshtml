
@{
    ViewData["Title"] = "MyView1";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>myView</title>

    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
                font-family: Segoe UI,Arial,sans-serif;
            }

            body {
                background: #f4f6f9;
                color: #333;
            }

            .header {
                background: #2563eb;
                color: white;
                padding: 20px 40px;
                display: flex;
                justify-content: space-between;
                align-items: center;
                box-shadow: 0 3px 8px rgba(0,0,0,.15);
            }

                .header h1 {
                    font-size: 28px;
                }

            .container {
                width: 95%;
                margin: 30px auto;
            }

            .cards {
                display: grid;
                grid-template-columns: repeat(auto-fit,minmax(220px,1fr));
                gap: 20px;
                margin-bottom: 30px;
            }

            .card {
                background: white;
                border-radius: 12px;
                padding: 25px;
                box-shadow: 0 4px 10px rgba(0,0,0,.08);
                transition: .3s;
            }

                .card:hover {
                    transform: translateY(-5px);
                }

                .card h3 {
                    color: #666;
                    margin-bottom: 12px;
                    font-size: 18px;
                }

                .card p {
                    font-size: 30px;
                    font-weight: bold;
                    color: #2563eb;
                }

            .panel {
                background: white;
                border-radius: 12px;
                padding: 25px;
                box-shadow: 0 4px 10px rgba(0,0,0,.08);
            }

                .panel h2 {
                    margin-bottom: 20px;
                    color: #2563eb;
                }

            table {
                width: 100%;
                border-collapse: collapse;
            }

            th {
                background: #2563eb;
                color: white;
                padding: 14px;
                text-align: left;
            }

            td {
                padding: 14px;
                border-bottom: 1px solid #ddd;
            }

            tr:hover {
                background: #f2f7ff;
            }

            .btn {
                background: #2563eb;
                color: white;
                border: none;
                padding: 10px 18px;
                border-radius: 6px;
                cursor: pointer;
                transition: .3s;
            }

                .btn:hover {
                    background: #1d4ed8;
                }

            .footer {
                text-align: center;
                margin: 40px;
                color: #777;
            }
    </style>

</head>
<body>

    <div class="header">
        <h1>myView</h1>
        <button class="btn">Refresh</button>
    </div>

    <div class="container">

        <div class="cards">

            <div class="card">
                <h3>Total Users</h3>
                <p>1,254</p>
            </div>

            <div class="card">
                <h3>Active</h3>
                <p>978</p>
            </div>

            <div class="card">
                <h3>Pending</h3>
                <p>54</p>
            </div>

            <div class="card">
                <h3>Revenue</h3>
                <p>$12.4K</p>
            </div>

        </div>

        <div class="panel">

            <h2>Recent Records</h2>

            <table>

                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Status</th>
                    <th>Date</th>
                </tr>

                <tr>
                    <td>101</td>
                    <td>John Smith</td>
                    <td>Active</td>
                    <td>15 Jul 2026</td>
                </tr>

                <tr>
                    <td>102</td>
                    <td>Sarah Ali</td>
                    <td>Pending</td>
                    <td>16 Jul 2026</td>
                </tr>

                <tr>
                    <td>103</td>
                    <td>Michael Lee</td>
                    <td>Active</td>
                    <td>17 Jul 2026</td>
                </tr>

                <tr>
                    <td>104</td>
                    <td>Emma Wilson</td>
                    <td>Inactive</td>
                    <td>18 Jul 2026</td>
                </tr>

            </table>

        </div>

    </div>

    <div class="footer">
        © 2026 myView. All Rights Reserved.
    </div>

</body>
</html>

