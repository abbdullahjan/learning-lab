@model List<WebApplication1.Models.Student>

<h2>Student List</h2>

<table border="1" cellpadding="8">

    <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Class</th>
        <th>CGPA</th>
    </tr>

    @foreach (var student in Model)
    {
        <tr>
            <td>@student.Id</td>
            <td>@student.Name</td>
            <td>@student.Class</td>
            <td>@student.CGPA</td>
        </tr>
    }
    <tr>
        <td>@Model[0].Id</td>
        <td>@Model[0].Name</td>
        <td>@Model[0].Class</td>
        <td>@Model[0].CGPA</td>
    </tr>

</table>